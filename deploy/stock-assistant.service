[Unit]
Description=Stock Assistant FastAPI service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stock-assistant
EnvironmentFile=/opt/stock-assistant/.env
ExecStart=/opt/stock-assistant/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
